{
  "name": "@webmail/webmail",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "admin": "node src/lib/server/cli/main.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run && pnpm run test:http",
    "test:http": "ORIGIN=http://localhost:4173 vite build && ORIGIN=https://webmail.survivus.com.br BUILD_OUT=test-results/build-prod vite build && playwright test --project=http --project=logs",
    "test:browser": "ORIGIN=http://localhost:4173 vite build && playwright test --project=firefox"
  },
  "dependencies": {
    "@webmail/shared": "workspace:*",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
