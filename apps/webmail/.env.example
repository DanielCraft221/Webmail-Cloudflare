# Webmail configuration. Fake values only: the real ones live outside the repository
# (development: ~/.config/webmail/webmail.env, chmod 600; production: /srv/webmail/.env, Etapa 7).
# The ADMIN_API_TOKEN never goes here: only the admin CLI has it (~/.config/webmail/admin.env).

# mail-core API (docs/api.md). Default: https://mail-api.survivus.com.br. Must be https.
MAIL_API_URL=https://mail-api.survivus.com.br
# Bearer for the webmail routes of the API (wrangler secret INTERNAL_API_TOKEN).
INTERNAL_API_TOKEN=fake-internal-token-replace-me
# Cloudflare Access Service Token "webmail" (Zero Trust > Service Tokens).
CF_ACCESS_CLIENT_ID=fake-client-id.access
CF_ACCESS_CLIENT_SECRET=fake-client-secret-replace-me
# AES-256-GCM key for the TOTP secrets, 32 bytes in base64 (openssl rand -base64 32).
# Generated once. A new key makes every stored 2FA unreadable (everyone redoes it via user:reset).
# The app refuses to start with this example value.
TOTP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Local SQLite (sessions, limits, bans). Default: ~/.local/share/webmail/webmail.db
WEBMAIL_DB_PATH=/data/webmail.db

# Required by every build (only `vite dev` is not production, whatever NODE_ENV says).
# The app refuses to start without it: the real IP comes from CF-Connecting-IP, trusted
# because only cloudflared reaches the container.
ADDRESS_HEADER=cf-connecting-ip
# Build time, not run time: ORIGIN=https://webmail.survivus.com.br pnpm build
# (it is also the CSRF origin).
