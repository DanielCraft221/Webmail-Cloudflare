{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mail-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // No workers.dev URL and no preview URLs. The API is reached only through its custom domain
  // behind Cloudflare Access (Etapa 3 PR 2).
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs storage is off: the platform adds the full envelope sender (mailFrom), rcptTo
  // and the full request URL to every log() line, with no way to exclude them (docs/decisoes.md).
  // `wrangler tail` still shows logs live.
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },
  // Not a secret: the Access team domain. ACCESS_AUD, ACCESS_CLIENT_ID and INTERNAL_API_TOKEN
  // are Worker secrets (`wrangler secret put`, docs/cloudflare.md).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://survivus-services.cloudflareaccess.com"
  },
  // account_id is intentionally absent: Wrangler reads CLOUDFLARE_ACCOUNT_ID (docs/decisoes.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webmail-db",
      // Not a secret: useless without an API token (docs/decisoes.md).
      "database_id": "64f7db21-6273-473a-9297-3e3d03ea7d41",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      // Private bucket: no public access, no r2.dev domain.
      "binding": "MAIL",
      "bucket_name": "webmail-mail"
    }
  ],
  // Per-user API limit, approximate and per Cloudflare location (docs/cloudflare-api.md).
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "mail-ingest"
      }
    ],
    "consumers": [
      {
        "queue": "mail-ingest",
        // One message per invocation keeps a 25 MiB parse inside the 128 MB memory limit.
        "max_batch_size": 1,
        // With the backoff in src/ingest.ts (30 s doubling, capped at 1 h) this covers about 4 h.
        "max_retries": 10,
        "dead_letter_queue": "mail-ingest-dlq"
      }
    ]
  }
}
