# Example only: fake values that document the format. Never put real values here.
# Real config lives outside the repo (see docs/segredos.md).
# Variables are added here as each stage needs them.

# Webmail (Etapa 5+): base URL of the mail-core internal API (docs/api.md).
MAIL_CORE_API_URL=https://mail-api.example.com

# Webmail (Etapa 5+) and mail-core secret: Bearer token for the internal API.
# Generate with: openssl rand -base64 48
INTERNAL_API_TOKEN=fake-token-replace-me

# Webmail (Etapa 5+): Cloudflare Access service token "webmail", sent as
# CF-Access-Client-Id / CF-Access-Client-Secret. The Client ID is also the
# mail-core secret ACCESS_CLIENT_ID.
CF_ACCESS_CLIENT_ID=fake-client-id.access
CF_ACCESS_CLIENT_SECRET=fake-client-secret-replace-me
