# Example only: fake values that document the format. Never put real values here.
# Real config lives outside the repo (see docs/segredos.md).
# Variables are added here as each stage needs them.

# Webmail (Etapa 5+): base URL of the mail-core Worker internal API.
MAIL_CORE_API_URL=https://mail-core.example.workers.dev

# Webmail (Etapa 5+): Bearer token for the mail-core internal API.
# Generate with: openssl rand -base64 32
MAIL_CORE_API_TOKEN=fake-token-replace-me
